# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# Create a bot application at https://discord.com/developers/applications
# and enable the "Server Members Intent" and "Message Content Intent".
DISCORD_TOKEN=your-bot-token-here

# Optional: a channel ID the bot will use for alerts if a guild has none configured.
DEFAULT_ALERT_CHANNEL_ID=

# Path to the per-guild config store (JSON). Defaults to ./guild_configs.json
ANTIRAID_CONFIG_PATH=guild_configs.json

# Path to the incident store (JSON) — remembers active lockdowns across restarts.
ANTIRAID_INCIDENTS_PATH=incidents.json
